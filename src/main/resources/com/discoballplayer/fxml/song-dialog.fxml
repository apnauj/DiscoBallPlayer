<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Add / edit form. Hosted in a modal window by MainController; the root is a plain VBox so
    the same markup can be loaded in a test without a Stage.
-->
<VBox fx:id="dialogRoot"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.discoballplayer.ui.SongDialogController"
      styleClass="dialog-root" spacing="16" prefWidth="520">

    <padding>
        <Insets top="22" right="24" bottom="20" left="24"/>
    </padding>

    <Label fx:id="dialogTitle" text="Add song" styleClass="dialog-title"/>

    <GridPane fx:id="formGrid" hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="96" prefWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints/>
        </columnConstraints>

        <Label text="Title" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="titleField" promptText="Required"
                   GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="Artist" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="artistField" promptText="Leave blank for an unknown artist"
                   GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="Album" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="albumField" promptText="Optional"
                   GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="Duration" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="durationField" promptText="m:ss, or a number of seconds"
                   GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="Genre" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="genreCombo" maxWidth="Infinity"
                  GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="Year" styleClass="field-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="yearField" promptText="1900 to 2100"
                   GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="Rating" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="ratingField" promptText="0 to 100"
                   GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

        <Label text="Cover" styleClass="field-label" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="coverField" promptText="Absolute path to an image"
                   GridPane.rowIndex="7" GridPane.columnIndex="1"/>
        <Button fx:id="browseCoverButton" text="Browse" onAction="#onBrowseCover"
                GridPane.rowIndex="7" GridPane.columnIndex="2"/>

        <Label text="Audio" styleClass="field-label" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextField fx:id="audioField" promptText="Absolute path to an audio file"
                   GridPane.rowIndex="8" GridPane.columnIndex="1"/>
        <Button fx:id="browseAudioButton" text="Browse" onAction="#onBrowseAudio"
                GridPane.rowIndex="8" GridPane.columnIndex="2"/>
    </GridPane>

    <Label fx:id="errorLabel" styleClass="error-message" wrapText="true" visible="false"
           managed="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel"/>
        <Button fx:id="saveButton" text="Save" onAction="#onSave" styleClass="primary-button"
                defaultButton="true"/>
    </HBox>

</VBox>

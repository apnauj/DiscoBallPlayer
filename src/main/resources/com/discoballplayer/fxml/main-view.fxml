<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Application shell: the three regions every later Track B ticket fills in.

      left    sidebar        mode selector (B4-03) and filters
      center  library        search box and the song table
      bottom  now playing    cover, metadata, progress and transport (B3, B4)
-->
<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.discoballplayer.ui.MainController"
            styleClass="root-pane">

    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="24" minWidth="200" prefWidth="220">
            <padding>
                <Insets top="20" right="18" bottom="20" left="18"/>
            </padding>

            <Label text="DiscoBallPlayer" styleClass="brand-title"/>

            <VBox fx:id="modeSelectorBox" styleClass="sidebar-section" spacing="8">
                <Label text="PLAYBACK MODE" styleClass="section-title"/>

                <fx:define>
                    <ToggleGroup fx:id="modeGroup"/>
                </fx:define>

                <RadioButton fx:id="shuffleModeButton" text="Shuffle" toggleGroup="$modeGroup"
                             onAction="#onShuffleMode" styleClass="mode-option"/>
                <RadioButton fx:id="arrivalModeButton" text="Arrival order" toggleGroup="$modeGroup"
                             onAction="#onArrivalMode" styleClass="mode-option"/>
                <RadioButton fx:id="alphabeticalModeButton" text="Alphabetical" toggleGroup="$modeGroup"
                             onAction="#onAlphabeticalMode" styleClass="mode-option"/>
            </VBox>

            <VBox fx:id="filterBox" styleClass="sidebar-section" spacing="8">
                <Label text="FILTERS" styleClass="section-title"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox fx:id="libraryContainer" styleClass="library-region" spacing="12">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <TextField fx:id="searchField" styleClass="search-field"
                       promptText="Search by title, artist or album"/>

            <!--
                The resize policy is what makes the columns share the width proportionally to
                their prefWidth, so the table grows with the window instead of leaving a gap.
            -->
            <TableView fx:id="libraryTable" styleClass="library-table" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="titleColumn" text="Title" prefWidth="230"/>
                    <TableColumn fx:id="artistColumn" text="Artist" prefWidth="170"/>
                    <TableColumn fx:id="albumColumn" text="Album" prefWidth="170"/>
                    <TableColumn fx:id="durationColumn" text="Duration" prefWidth="90"/>
                    <TableColumn fx:id="genreColumn" text="Genre" prefWidth="110"/>
                    <TableColumn fx:id="yearColumn" text="Year" prefWidth="80"/>
                    <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox fx:id="nowPlayingBar" styleClass="now-playing-bar"
              alignment="CENTER_LEFT" spacing="18" minHeight="96">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20"/>
            </padding>

            <!-- 64x64 by contract: B3-02 swaps the image, never the box, so the bar
                 never reflows when a cover is missing or fails to decode. -->
            <ImageView fx:id="coverImage" fitWidth="64" fitHeight="64"
                       preserveRatio="false" smooth="true"/>

            <VBox alignment="CENTER_LEFT" spacing="4" minWidth="200" prefWidth="240">
                <Label fx:id="nowPlayingTitle" styleClass="now-playing-title" text="Nothing playing"/>
                <Label fx:id="nowPlayingArtist" styleClass="now-playing-artist" text="Pick a song to begin"/>
            </VBox>

            <HBox alignment="CENTER" spacing="8" styleClass="transport">
                <Button fx:id="previousButton" text="Previous" onAction="#onPrevious"
                        styleClass="transport-button"/>
                <Button fx:id="playPauseButton" text="Play" onAction="#onPlayPause"
                        styleClass="transport-button, primary-button" minWidth="90"/>
                <Button fx:id="nextButton" text="Next" onAction="#onNext"
                        styleClass="transport-button"/>
            </HBox>

            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="6">
                <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity"/>
                <HBox spacing="8">
                    <Label fx:id="elapsedLabel" styleClass="time-label" text="0:00"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" styleClass="time-label" text="0:00"/>
                </HBox>
            </VBox>

            <Label fx:id="statusLabel" styleClass="status-label" minWidth="140"
                   alignment="CENTER_RIGHT"/>
        </HBox>
    </bottom>

</BorderPane>
